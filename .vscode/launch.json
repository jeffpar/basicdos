{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // Each browser configuration also passes its URL in runtimeArgs, so that Chrome opens the page itself; otherwise,
  // the debugger starts Chrome on about:blank and then navigates, which can leave focus in the address bar (so typing
  // meant for the machine goes there instead, and Enter reloads the page).
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS Demos",
      "url": "http://localhost:4040/demos/",
      "runtimeArgs": ["http://localhost:4040/demos/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS on an IBM PC",
      "url": "http://localhost:4040/demos/bd/s80/pc/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/s80/pc/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with Dual Monitors",
      "url": "http://localhost:4040/demos/bd/dual/xt/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/dual/xt/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with Dueling Monitors",
      "url": "http://localhost:4040/demos/bd/dual/multi/xt/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/dual/multi/xt/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS on a Hard Disk",
      "url": "http://localhost:4040/demos/bd/hd/xt/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/hd/xt/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a Serial Port",
      "url": "http://localhost:4040/demos/bd/serial/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/serial/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a VT100 Terminal",
      "url": "http://localhost:4040/demos/bd/vt100/xt/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/vt100/xt/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a Serial Debugger",
      "url": "http://localhost:4040/demos/bd/debug/at/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/debug/at/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS Protected Mode",
      "url": "http://localhost:4040/demos/bd/mmu/",
      "runtimeArgs": ["http://localhost:4040/demos/bd/mmu/"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "gulp build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/gulp/bin/gulp.js",
      "args": ["build"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "console": "internalConsole"
    }
  ]
}
