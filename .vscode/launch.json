{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS on an IBM PC",
      "url": "http://localhost:4040/demos/s80/pc/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with Dual Monitors",
      "url": "http://localhost:4040/demos/dual/xt/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with Dueling Monitors",
      "url": "http://localhost:4040/demos/dual/multi/xt/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS on a Hard Disk",
      "url": "http://localhost:4040/demos/hd/xt/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a Serial Display",
      "url": "http://localhost:4040/demos/serial/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a VT100 Terminal",
      "url": "http://localhost:4040/demos/vt100/xt/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "BASIC-DOS with a Serial Debugger",
      "url": "http://localhost:4040/demos/debug/at/debugger/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "gulp build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/gulp/bin/gulp.js",
      "args": ["build"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "console": "internalConsole"
    }
  ]
}
