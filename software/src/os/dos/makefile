ASM=MASM
LINK=LINK
EXE2BIN=EXE2BIN
AFLAGS=/MX /R /D$(REL) /I..\INC
#
# Listings are off; to create them, set LST=OBJ\$*.LST
#
LST=NUL

#
# Every module depends on OBJ\INCS, an empty file that's re-created whenever
# any include file changes, so that every module is rebuilt then, too (MAKE
# has no pseudo-targets, and MS-DOS's COPY would keep the old file's time).
#
OBJ\INCS: ..\INC\8086.INC ..\INC\BIOS.INC ..\INC\CPU.INC ..\INC\DEV.INC \
	..\INC\DEVAPI.INC ..\INC\DISK.INC ..\INC\DOS.INC ..\INC\DOSAPI.INC \
	..\INC\FPU.INC ..\INC\MACROS.INC ..\INC\PARSER.INC ..\INC\UART.INC \
	..\INC\UTIL.INC ..\INC\VERSION.INC
	TYPE NUL > OBJ\INCS

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.OBJ:
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DOSDATA.OBJ: DOSDATA.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DOSINTS.OBJ: DOSINTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CONIO.OBJ: CONIO.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BUFFER.OBJ: BUFFER.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DEVICE.OBJ: DEVICE.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DISK.OBJ: DISK.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FIND.OBJ: FIND.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FAT.OBJ: FAT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FCBIO.OBJ: FCBIO.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FILE.OBJ: FILE.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\PATH.OBJ: PATH.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\HANDLE.OBJ: HANDLE.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MEMORY.OBJ: MEMORY.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MATH.OBJ: MATH.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MISC.OBJ: MISC.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\PROCESS.OBJ: PROCESS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SESSION.OBJ: SESSION.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SPRINTF.OBJ: SPRINTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\UTILITY.OBJ: UTILITY.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\UTILSYS.OBJ: UTILSYS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SYSINIT.OBJ: SYSINIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SYSHELP.OBJ: SYSHELP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DRVINIT.OBJ: DRVINIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BASDOS.COM: OBJ\DOSDATA.OBJ OBJ\DOSINTS.OBJ OBJ\CONIO.OBJ OBJ\DEVICE.OBJ \
	OBJ\DISK.OBJ OBJ\FIND.OBJ OBJ\BUFFER.OBJ OBJ\PATH.OBJ \
	OBJ\FAT.OBJ OBJ\FCBIO.OBJ OBJ\FILE.OBJ OBJ\HANDLE.OBJ \
	OBJ\MATH.OBJ OBJ\MEMORY.OBJ OBJ\MISC.OBJ OBJ\PROCESS.OBJ \
	OBJ\SESSION.OBJ OBJ\SPRINTF.OBJ OBJ\UTILITY.OBJ OBJ\UTILSYS.OBJ \
	OBJ\SYSINIT.OBJ OBJ\SYSHELP.OBJ OBJ\DRVINIT.OBJ \
	BASDOS.LRF
	$(LINK) @$*.LRF
	$(EXE2BIN) OBJ\$*.EXE $@
	DEL OBJ\$*.EXE
