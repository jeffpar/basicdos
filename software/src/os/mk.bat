	REM Usage: MK [FINAL or DEBUG] [CLEAN] (DEBUG is the default, unless
	REM there's an MKFINAL file in the parent directory, as there is for
	REM MKDOS.BAT; CLEAN deletes everything in each OBJ folder for a clean
	REM build).
	REM Builds BASIC-DOS on BASIC-DOS (eg, in SRC on BASICDOS-10MB).
	REM NOTE: MAKE can't tell when the mode changes, so use CLEAN to
	REM rebuild everything in a new mode.
	M$ = UCASE$(ARG$(1))
	IF M$ = "" AND EXISTS("..\MKFINAL") THEN M$ = "FINAL"
	IF M$ = "" THEN M$ = "DEBUG"
	IF M$ <> "FINAL" AND M$ <> "DEBUG" THEN 200
	C$ = UCASE$(ARG$(2))
	IF C$ <> "" AND C$ <> "CLEAN" THEN 200
	CD BOOT
	GOSUB 300
	IF ERRORLEVEL = 0 THEN OBJ\WBOOT OBJ\BOOT1.COM OBJ\BOOT2.COM /N
	IF ERRORLEVEL = 0 THEN CD ..\DD\DBG : GOSUB 300 : CD ..
	IF ERRORLEVEL = 0 THEN CD ..\DEV : GOSUB 300
	IF ERRORLEVEL = 0 THEN CD ..\DOS : GOSUB 300
	IF ERRORLEVEL = 0 THEN CD ..\CMD : GOSUB 300
	IF ERRORLEVEL = 0 THEN CD ..\UTIL\MISC : GOSUB 300 : CD ..
	IF ERRORLEVEL = 0 THEN CD VI : GOSUB 300 : CD ..
	IF ERRORLEVEL THEN PRINT "MK failed"
	CD ..
	END
200	PRINT "Usage: MK [FINAL or DEBUG] [CLEAN]"
	END
300	IF NOT EXISTS("OBJ") THEN MD OBJ
	IF C$ = "CLEAN" THEN GOSUB 400
	IF M$ = "DEBUG" THEN MAKE REL=DEBUG MAKEFILE : RETURN
	MAKE REL=FINAL MAKEFILE
	RETURN
400	T$ = ".OBJ.COM.EXE.SYS.MAP.SYM.LST.BIN"
	FOR I = 1 TO LEN(T$) STEP 4
	F$ = "OBJ\*" + MID$(T$,I,4)
	IF EXISTS(F$) THEN DEL F$
	NEXT
	RETURN
