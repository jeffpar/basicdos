OBJ\GFXC.OBJ: GFXC.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFXPT.OBJ: GFXPT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFXDRAW.OBJ: GFXDRAW.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\STRVAR.OBJ: STRVAR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DETOK.OBJ: DETOK.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\EDIT.OBJ: EDIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\EDITCMD.OBJ: EDITCMD.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

