ASM=MASM
LINK=LINK
EXE2BIN=EXE2BIN
AFLAGS=/MX /R /D$(REL) /I. /I..\INC
#
# Listings are off; to create them, set LST=OBJ\$*.LST
#
LST=NUL

#
# Every module depends on OBJ\INCS, an empty file that's re-created whenever
# any include file changes, so that every module is rebuilt then, too (MAKE
# has no pseudo-targets, and MS-DOS's COPY would keep the old file's time).
#
OBJ\INCS: ARR.INC CMD.INC FILEIO.INC GEN.INC ..\INC\8086.INC ..\INC\BIOS.INC \
	..\INC\DEV.INC ..\INC\DEVAPI.INC ..\INC\DISK.INC ..\INC\DOS.INC \
	..\INC\DOSAPI.INC ..\INC\FPU.INC ..\INC\MACROS.INC ..\INC\PARSER.INC \
	..\INC\UART.INC ..\INC\UTIL.INC ..\INC\VERSION.INC
	TYPE NUL > OBJ\INCS

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.OBJ:
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\RES.OBJ: RES.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CMD.OBJ: CMD.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\TIME.OBJ: TIME.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DIR.OBJ: DIR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DIRCMD.OBJ: DIRCMD.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\HELP.OBJ: HELP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENCMD.OBJ: GENCMD.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENTOK.OBJ: GENTOK.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENEXP.OBJ: GENEXP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFUNC.OBJ: GENFUNC.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENEMIT.OBJ: GENEMIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFLOW.OBJ: GENFLOW.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENCON.OBJ: GENCON.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFPU.OBJ: GENFPU.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENDEF.OBJ: GENDEF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENSYS.OBJ: GENSYS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENPRTF.OBJ: GENPRTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENGFX.OBJ: GENGFX.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFILE.OBJ: GENFILE.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FILEIO.OBJ: FILEIO.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\INPUT.OBJ: INPUT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\ARR.OBJ: ARR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FLOW.OBJ: FLOW.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFX.OBJ: GFX.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFXIMG.OBJ: GFXIMG.ASM OBJ\INCS
