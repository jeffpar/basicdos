	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FUNCS.OBJ: FUNCS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CONST.OBJ: CONST.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\HEAP.OBJ: HEAP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

#
# The link order (see CMD.LRF) matters: every module through CONST.OBJ is the
# core, the modules after it (graphics and MOUSE, sound, the tokenized file
# loader, PRINTF, AUTO/DELETE/EDIT, file I/O, and CHAIN/MERGE) are loaded only
# when memory allows (see HEAPDEF in CMD.INC), and HEAP.OBJ must be last.
#
OBJ\COMMAND.COM: OBJ\RES.OBJ OBJ\CMD.OBJ OBJ\TIME.OBJ OBJ\DIR.OBJ \
	OBJ\DIRCMD.OBJ OBJ\HELP.OBJ OBJ\GENCMD.OBJ OBJ\GENTOK.OBJ \
	OBJ\GENEXP.OBJ OBJ\GENFUNC.OBJ OBJ\GENEMIT.OBJ OBJ\GENFLOW.OBJ \
	OBJ\GENCON.OBJ OBJ\GENFPU.OBJ OBJ\GENDEF.OBJ OBJ\GENSYS.OBJ \
	OBJ\GENGFX.OBJ OBJ\GENFILE.OBJ OBJ\FILEIO.OBJ OBJ\INPUT.OBJ \
	OBJ\ARR.OBJ OBJ\FLOW.OBJ OBJ\GFX.OBJ OBJ\GFXDRAW.OBJ \
	OBJ\GFXIMG.OBJ OBJ\GFXC.OBJ OBJ\GFXPT.OBJ OBJ\DETOK.OBJ \
	OBJ\EDIT.OBJ OBJ\EDITCMD.OBJ OBJ\CHAIN.OBJ OBJ\GENPRTF.OBJ \
	OBJ\LIBC.OBJ OBJ\LONG.OBJ OBJ\MEM.OBJ OBJ\SESSION.OBJ \
	OBJ\STR.OBJ OBJ\STRHELP.OBJ OBJ\STRMISC.OBJ OBJ\SYS.OBJ \
	OBJ\SND.OBJ OBJ\STRVAR.OBJ OBJ\VAR.OBJ OBJ\FUNCS.OBJ \
	OBJ\CONST.OBJ OBJ\HEAP.OBJ \
	CMD.LRF
	$(LINK) @CMD.LRF
	$(EXE2BIN) OBJ\$*.EXE $@
	DEL OBJ\$*.EXE
