	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SESSION.OBJ: SESSION.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\STR.OBJ: STR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

