ASM=MASM
LINK=LINK
EXE2BIN=EXE2BIN
AFLAGS=/MX /R /D$(REL) /I. /I..\INC
#
# Listings are off; to create them, set LST=OBJ\$*.LST
#
LST=NUL

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.OBJ:
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\RES.OBJ: RES.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CMD.OBJ: CMD.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\TIME.OBJ: TIME.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DIR.OBJ: DIR.ASM CMD.INC ..\INC\UTIL.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\HELP.OBJ: HELP.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENCMD.OBJ: GENCMD.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENTOK.OBJ: GENTOK.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENEXP.OBJ: GENEXP.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFUNC.OBJ: GENFUNC.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENEMIT.OBJ: GENEMIT.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFLOW.OBJ: GENFLOW.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENCON.OBJ: GENCON.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFPU.OBJ: GENFPU.ASM CMD.INC GEN.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENDEF.OBJ: GENDEF.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENSYS.OBJ: GENSYS.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENPRTF.OBJ: GENPRTF.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENGFX.OBJ: GENGFX.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENFILE.OBJ: GENFILE.ASM CMD.INC GEN.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FILEIO.OBJ: FILEIO.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\ARR.OBJ: ARR.ASM CMD.INC ARR.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FLOW.OBJ: FLOW.ASM CMD.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFX.OBJ: GFX.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFXIMG.OBJ: GFXIMG.ASM CMD.INC ARR.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GFXC.OBJ: GFXC.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DETOK.OBJ: DETOK.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\EDIT.OBJ: EDIT.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\EDITCMD.OBJ: EDITCMD.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\LIBC.OBJ: LIBC.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\LONG.OBJ: LONG.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MEM.OBJ: MEM.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SESSION.OBJ: SESSION.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\STR.OBJ: STR.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\STRHELP.OBJ: STRHELP.ASM CMD.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\STRMISC.OBJ: STRMISC.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SYS.OBJ: SYS.ASM CMD.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SND.OBJ: SND.ASM CMD.INC ..\INC\BIOS.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\VAR.OBJ: VAR.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FUNCS.OBJ: FUNCS.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CONST.OBJ: CONST.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\HEAP.OBJ: HEAP.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

#
# The link order (see CMD.LRF) matters: every module through CONST.OBJ is the
# core, the modules after it (graphics and MOUSE, sound, the tokenized file
# loader, PRINTF, and AUTO/DELETE/EDIT) are loaded only when memory allows
# (see HEAPDEF in CMD.INC), and HEAP.OBJ must be last.
#
OBJ\COMMAND.COM: OBJ\RES.OBJ OBJ\CMD.OBJ OBJ\TIME.OBJ OBJ\DIR.OBJ OBJ\HELP.OBJ OBJ\GENCMD.OBJ OBJ\GENTOK.OBJ OBJ\GENEXP.OBJ OBJ\GENFUNC.OBJ OBJ\GENEMIT.OBJ OBJ\GENFLOW.OBJ OBJ\GENCON.OBJ \
	OBJ\GENFPU.OBJ OBJ\GENDEF.OBJ OBJ\GENSYS.OBJ OBJ\GENGFX.OBJ \
	OBJ\GENFILE.OBJ OBJ\FILEIO.OBJ \
	OBJ\ARR.OBJ OBJ\FLOW.OBJ OBJ\GFX.OBJ OBJ\GFXIMG.OBJ OBJ\GFXC.OBJ OBJ\DETOK.OBJ \
	OBJ\EDIT.OBJ OBJ\EDITCMD.OBJ OBJ\GENPRTF.OBJ \
	OBJ\LIBC.OBJ OBJ\LONG.OBJ \
	OBJ\MEM.OBJ OBJ\SESSION.OBJ OBJ\STR.OBJ OBJ\STRHELP.OBJ OBJ\STRMISC.OBJ OBJ\SYS.OBJ OBJ\SND.OBJ OBJ\VAR.OBJ \
	OBJ\FUNCS.OBJ OBJ\CONST.OBJ OBJ\HEAP.OBJ \
	CMD.LRF
	$(LINK) @CMD.LRF
	$(EXE2BIN) OBJ\$*.EXE $@
	DEL OBJ\$*.EXE
