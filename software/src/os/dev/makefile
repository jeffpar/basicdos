OBJ\BASDEV.COM: ..\BOOT\OBJ\BOOT2.COM OBJ\CPUDEV.COM OBJ\NULDEV.COM \
	OBJ\CONDEV.COM OBJ\COMDEV.COM OBJ\LPTDEV.COM OBJ\CLKDEV.COM \
	OBJ\FDCDEV.COM OBJ\HDCDEV.COM OBJ\PIPEDEV.COM OBJ\FPUDEV.COM \
	OBJ\MOUDEV.COM OBJ\DEVINIT.COM
	COPY /B ..\BOOT\OBJ\BOOT2.COM+OBJ\CPUDEV.COM+OBJ\NULDEV.COM+OBJ\CONDEV.COM OBJ\BASDEV.BIN
	COPY /B OBJ\BASDEV.BIN+OBJ\COMDEV.COM+OBJ\LPTDEV.COM+OBJ\CLKDEV.COM OBJ\BASDEV.COM
	COPY /B OBJ\BASDEV.COM+OBJ\FDCDEV.COM+OBJ\HDCDEV.COM+OBJ\PIPEDEV.COM+OBJ\FPUDEV.COM OBJ\BASDEV.BIN
	COPY /B OBJ\BASDEV.BIN+OBJ\MOUDEV.COM+OBJ\DEVINIT.COM OBJ\BASDEV.COM
	DEL OBJ\BASDEV.BIN
