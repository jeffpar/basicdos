ASM=MASM
LINK=LINK
AFLAGS=/D$(REL) /I.
#
# Listings are off; to create them, set LST=OBJ\$*.LST
#
LST=NUL
MAPSYM=MAPSYM

#
# Every module depends on OBJ\INCS, an empty file that's re-created whenever
# any include file changes, so that every module is rebuilt then, too (MAKE
# has no pseudo-targets, and MS-DOS's COPY would keep the old file's time).
# MATH.ASM includes MATH1.ASM and MATH2.ASM, so they're include files, too.
#
OBJ\INCS: BINTRP.INC GIO86U.INC IBMRES.INC MSDOSU.INC OEM.INC MATH1.ASM \
	MATH2.ASM
	TYPE NUL > OBJ\INCS

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.OBJ:
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWDATA.OBJ: GWDATA.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWMAIN.OBJ: GWMAIN.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\OEM.OBJ: OEM.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWEVAL.OBJ: GWEVAL.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWLIST.OBJ: GWLIST.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\IBMRES.OBJ: IBMRES.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BIMISC.OBJ: BIMISC.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\DSKCOM.OBJ: DSKCOM.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BIPTRG.OBJ: BIPTRG.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BIPRTU.OBJ: BIPRTU.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BISTRS.OBJ: BISTRS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\FIVEO.OBJ: FIVEO.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GENGRP.OBJ: GENGRP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\ADVGRP.OBJ: ADVGRP.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MACLNG.OBJ: MACLNG.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWSTS.OBJ: GWSTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIO86.OBJ: GIO86.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIODSK.OBJ: GIODSK.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOKYB.OBJ: GIOKYB.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOSCN.OBJ: GIOSCN.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOLPT.OBJ: GIOLPT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOCOM.OBJ: GIOCOM.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOCON.OBJ: GIOCON.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOTBL.OBJ: GIOTBL.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SCNEDT.OBJ: SCNEDT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\SCNDRV.OBJ: SCNDRV.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\CALL86.OBJ: CALL86.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\NEXT86.OBJ: NEXT86.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MATH.OBJ: MATH.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\KANJ86.OBJ: KANJ86.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GIOCAS.OBJ: GIOCAS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\ITSA86.OBJ: ITSA86.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWRAM.OBJ: GWRAM.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\GWINIT.OBJ: GWINIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\BIBOOT.OBJ: BIBOOT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) $*.ASM,$@,$(LST);

OBJ\MSBASIC.EXE: OBJ\GWDATA.OBJ OBJ\GWMAIN.OBJ OBJ\OEM.OBJ OBJ\GWEVAL.OBJ \
	OBJ\GWLIST.OBJ OBJ\IBMRES.OBJ OBJ\BIMISC.OBJ OBJ\DSKCOM.OBJ \
	OBJ\BIPTRG.OBJ OBJ\BIPRTU.OBJ OBJ\BISTRS.OBJ OBJ\FIVEO.OBJ \
	OBJ\GENGRP.OBJ OBJ\ADVGRP.OBJ OBJ\MACLNG.OBJ OBJ\GWSTS.OBJ \
	OBJ\GIO86.OBJ OBJ\GIODSK.OBJ OBJ\GIOKYB.OBJ OBJ\GIOSCN.OBJ \
	OBJ\GIOLPT.OBJ OBJ\GIOCOM.OBJ OBJ\GIOCON.OBJ OBJ\GIOTBL.OBJ \
	OBJ\SCNEDT.OBJ OBJ\SCNDRV.OBJ OBJ\CALL86.OBJ OBJ\NEXT86.OBJ \
	OBJ\MATH.OBJ OBJ\KANJ86.OBJ OBJ\GIOCAS.OBJ OBJ\ITSA86.OBJ \
	OBJ\GWRAM.OBJ OBJ\GWINIT.OBJ OBJ\BIBOOT.OBJ MSBASIC.LRF
	$(LINK) @$*.LRF
	EXEMOD OBJ\MSBASIC.EXE /MIN 400
	CD OBJ
	$(MAPSYM) $*
	CD ..
