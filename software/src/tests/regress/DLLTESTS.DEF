;
; BASIC-DOS NE Library Tests: module definitions for LINK4, which builds
; DLLTESTS.EXE as an NE program (see the TESTS makefile) whose stub is a
; real-mode program that says the tests were skipped.  IMPORTS names the
; library functions it calls, by module and ordinal.
;
; @author Jeff Parsons <Jeff@pcjs.org>
; @copyright (c) 2026 Jeff Parsons
; @license MIT <https://basicdos.com/LICENSE.txt>
;
; This file is part of PCjs, a computer emulation software project at pcjs.org
;
NAME	DLLTESTS
STUB	'OBJ\DLLTESTS.EXE'
PROTMODE
CODE	FIXED
DATA	FIXED
IMPORTS
	DOSEXIT=DOSCALLS.5
	DOSSETSIGHANDLER=DOSCALLS.14
	DOSALLOCSEG=DOSCALLS.34
	DOSREALLOCSEG=DOSCALLS.38
	DOSFREESEG=DOSCALLS.39
	DOSGETMACHINEMODE=DOSCALLS.49
	DOSDEVIOCTL=DOSCALLS.53
	DOSCHGFILEPTR=DOSCALLS.58
	DOSCLOSE=DOSCALLS.59
	DOSDELETE=DOSCALLS.60
	DOSFINDCLOSE=DOSCALLS.63
	DOSFINDFIRST=DOSCALLS.64
	DOSFINDNEXT=DOSCALLS.65
	DOSNEWSIZE=DOSCALLS.68
	DOSOPEN=DOSCALLS.70
	DOSQCURDISK=DOSCALLS.72
	DOSQFILEMODE=DOSCALLS.75
	DOSQHANDTYPE=DOSCALLS.77
	DOSSETMAXFH=DOSCALLS.85
	DOSSETVEC=DOSCALLS.89
	DOSGETVERSION=DOSCALLS.92
	DOSGETPID=DOSCALLS.94
	DOSREAD=DOSCALLS.137
	DOSWRITE=DOSCALLS.138
