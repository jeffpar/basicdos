10 REM MOVES.BAS: same-drive file rename and move tests
20 MD MVA : MD MVB : MD MVA/SUB
30 OPEN "MVA/F.DAT" FOR OUTPUT AS #1
40 FOR I = 1 TO 20
50 PRINT #1, STRING$(120,64+I)
60 NEXT I
70 CLOSE #1
80 OPEN "MVB/TAKEN.DAT" FOR OUTPUT AS #1 : PRINT #1, "keep" : CLOSE #1
85 FOR J = 1 TO 29
86 F$ = "MVB/E" + MID$(STR$(J),2) + ".TMP"
87 OPEN F$ FOR OUTPUT AS #1 : CLOSE #1
88 NEXT J
90 REN MVA/F.DAT MVB/TAKEN.DAT
100 IF ERRORLEVEL = 0 THEN PRINT "collision failed"
110 MV MVA/F.DAT MISSING/NO.DAT
120 IF ERRORLEVEL = 0 THEN PRINT "missing directory failed"
130 OPEN "MVA/F.DAT" FOR INPUT AS #1
140 MV MVA/F.DAT MVB/F.DAT
150 IF ERRORLEVEL = 0 THEN PRINT "open file move failed"
160 IF LOF(1) <> 2440 THEN PRINT "source length failed"
170 CLOSE #1
180 MV MVA/F.DAT MVB
190 IF ERRORLEVEL <> 0 THEN PRINT "move to directory failed"
200 DIR MVA/F.DAT
210 IF ERRORLEVEL = 0 THEN PRINT "source still exists failed"
220 REN MVB/F.DAT MVA/REN.DAT
230 IF ERRORLEVEL <> 0 THEN PRINT "cross-directory rename failed"
240 RENAME MVA/REN.DAT MVA/DONE.DAT
250 IF ERRORLEVEL <> 0 THEN PRINT "same-directory rename failed"
260 MV MVA/DONE.DAT /FINAL.DAT
270 IF ERRORLEVEL <> 0 THEN PRINT "move to root failed"
280 REN /FINAL.DAT MVB
290 IF ERRORLEVEL <> 0 THEN PRINT "move from root failed"
300 OPEN "MVB/FINAL.DAT" FOR INPUT AS #1
310 IF LOF(1) <> 2440 THEN PRINT "destination length failed"
320 FOR I = 1 TO 20
330 LINE INPUT #1, L$
340 IF L$ <> STRING$(120,64+I) THEN PRINT "moved contents failed"
350 NEXT I
360 IF NOT EOF(1) THEN PRINT "moved EOF failed"
370 CLOSE #1
380 OPEN "MVB/TAKEN.DAT" FOR INPUT AS #1 : LINE INPUT #1, L$ : CLOSE #1
390 IF L$ <> "keep" THEN PRINT "collision contents failed"
400 OPEN "MVA/SUB/KID.DAT" FOR OUTPUT AS #1 : PRINT #1, "child" : CLOSE #1
410 MV MVA MVA/SUB
420 IF ERRORLEVEL = 0 THEN PRINT "descendant move failed"
430 MV MVA/SUB MVA/SUB
440 IF ERRORLEVEL = 0 THEN PRINT "self move failed"
450 OPEN "MVA/SUB/KID.DAT" FOR INPUT AS #1
460 CD MVA/SUB
470 MV /MVA/SUB /MVB/NEW
480 IF ERRORLEVEL <> 0 THEN PRINT "directory move failed"
485 CD
490 LINE INPUT #1, L$ : CLOSE #1
500 IF L$ <> "child" THEN PRINT "open child contents failed"
510 OPEN "KID.DAT" FOR INPUT AS #1 : LINE INPUT #1, L$ : CLOSE #1
520 IF L$ <> "child" THEN PRINT "current directory failed"
530 CD ..
540 OPEN "NEW/KID.DAT" FOR INPUT AS #1 : CLOSE #1
550 IF ERRORLEVEL <> 0 THEN PRINT "new parent failed"
555 CD NEW
560 MV /MVB /TREE
570 IF ERRORLEVEL <> 0 THEN PRINT "ancestor move failed"
575 CD
580 OPEN "KID.DAT" FOR INPUT AS #1 : CLOSE #1
590 IF ERRORLEVEL <> 0 THEN PRINT "ancestor current directory failed"
595 CD ..
600 CD /
610 MV TREE/NEW /ROOTDIR
620 IF ERRORLEVEL <> 0 THEN PRINT "directory to root failed"
630 CD ROOTDIR : CD ..
640 OPEN "ROOTDIR/KID.DAT" FOR INPUT AS #1 : CLOSE #1
650 IF ERRORLEVEL <> 0 THEN PRINT "root parent failed"
660 MV ROOTDIR MVA
670 IF ERRORLEVEL <> 0 THEN PRINT "directory from root failed"
680 REN MVA/ROOTDIR MVA/DONE
690 IF ERRORLEVEL <> 0 THEN PRINT "directory rename failed"
700 DEL MVA/DONE/KID.DAT : RD MVA/DONE
710 DEL TREE/FINAL.DAT : DEL TREE/TAKEN.DAT : DEL TREE/*.TMP
720 RD MVA : RD TREE
730 IF ERRORLEVEL <> 0 THEN PRINT "move cleanup failed"
740 PRINT "MOVES done"
