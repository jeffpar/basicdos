10 REM BENCH.BAS: BASIC benchmarks for BASIC-DOS, BASICA, and GW-BASIC
20 REM Each test's time is measured in BIOS timer ticks (18.2 per second)
30 DEFINT I-N:DEFDBL A-H,O-Z
40 DIM R(10),A(500)
50 DEF SEG=0
60 Q=0
100 REM 1. Integer math
110 GOSUB 9000
120 FOR I=1 TO 5000:J=I*3\7+I MOD 13-I\5+(I AND 255):NEXT
130 GOSUB 9100
200 REM 2. Floating-point math (double precision)
210 GOSUB 9000:X=0
220 FOR I=1 TO 2000:X=X*.999#+I/3.7#-1.5#:NEXT
230 GOSUB 9100
400 REM 3. Math functions
410 GOSUB 9000
420 FOR I=1 TO 200:X=SQR(I)+SIN(I)+COS(I)+ATN(I)+LOG(I)+EXP(I/100):NEXT
430 GOSUB 9100
500 REM 4. String functions
510 GOSUB 9000
520 FOR I=1 TO 500:A$=STR$(I)+"ABC":B$=LEFT$(A$,2)+MID$(A$,2,3)+RIGHT$(A$,2)
530 K=LEN(B$)+ASC(B$)+INSTR(B$,"B"):NEXT
540 GOSUB 9100
600 REM 5. Arrays and subroutines
610 GOSUB 9000:S=0
620 FOR I=1 TO 500:A(I)=I*2:NEXT
630 FOR I=1 TO 500:GOSUB 8000:NEXT
640 GOSUB 9100
700 REM 6. Primes (trial division, all odd numbers below 3000)
710 GOSUB 9000:KP=1
720 FOR K=3 TO 2999 STEP 2:L=3
730 IF L*L>K THEN KP=KP+1:GOTO 750
740 IF K MOD L<>0 THEN L=L+2:GOTO 730
750 NEXT
760 GOSUB 9100
800 REM 7. Screen output
810 CLS:GOSUB 9000
820 FOR I=1 TO 100:PRINT "LINE";I;"THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG":NEXT
830 GOSUB 9100
900 REM 8. Graphics: PSET
910 SCREEN 1:CLS:GOSUB 9000
920 FOR J=0 TO 99 STEP 3:FOR I=0 TO 319 STEP 2:PSET(I,J),J MOD 3+1:NEXT:NEXT
930 GOSUB 9100
1000 REM 9. Graphics: LINE
1010 CLS:GOSUB 9000
1020 FOR I=0 TO 319 STEP 4:LINE(I,0)-(319-I,199),I MOD 3+1:NEXT
1030 FOR I=0 TO 199 STEP 4:LINE(0,I)-(319,199-I),2:NEXT
1040 GOSUB 9100
1100 REM 10. Graphics: one pass of CIRCLE.BAS (CIRCLE and PAINT)
1110 CLS:GOSUB 9000
1120 S1!=2.5:S2!=1.3:A!=0
1130 FOR R!=5 TO 100 STEP 2
1140 A2!=A!+S1!:IF A2!>6.28 THEN A2!=A2!-6.28
1150 CIRCLE(160,100),R!,2,A!,A2!,5/6
1160 A!=A!+S2!:IF A!>6.28 THEN A!=A!-6.28
1170 NEXT
1180 PAINT(160,100),3,2
1190 GOSUB 9100
1205 SCREEN 0:WIDTH 80:CLS
1210 PRINT "PRIMES:";KP
1220 FOR I=1 TO Q:PRINT "TEST";I;"TICKS";R(I):NEXT
1230 END
8000 S=S+A(I):RETURN
9000 T0=PEEK(&H46C)
9010 IF PEEK(&H46C)=T0 THEN 9010
9020 T0=PEEK(&H46C)+256*PEEK(&H46D):RETURN
9100 T1=PEEK(&H46C)+256*PEEK(&H46D):Q=Q+1:R(Q)=T1-T0
9110 IF R(Q)<0 THEN R(Q)=R(Q)+65536
9115 PRINT Q;R(Q);
9120 RETURN
