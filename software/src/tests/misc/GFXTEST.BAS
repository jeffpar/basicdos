10 REM GFXTEST.BAS: graphics tests (STEP, POINT, DRAW A, TA, P, and X, GET and
20 REM PUT with double arrays, PLAY's semicolons and X, VIEW, WINDOW, PMAP, and PAINT tiles)
30 SCREEN 1 : CLS : FAILS = 0 : F$ = ""
40 PSET (10,10),1 : IF POINT(10,10) <> 1 THEN F$ = F$ + " PSET"
50 PSET STEP(5,5),2 : IF POINT(15,15) <> 2 THEN F$ = F$ + " STEP"
60 IF POINT(0) <> 15 OR POINT(1) <> 15 THEN F$ = F$ + " POINT(n)"
70 IF POINT(-1,-1) <> -1 OR POINT(320,0) <> -1 THEN F$ = F$ + " POINT(off)"
80 LINE (60,160)-STEP(10,5),1 : IF POINT(70,165) <> 1 OR POINT(0) <> 70 THEN F$ = F$ + " LINE-STEP"
90 LINE -STEP(5,0),2 : IF POINT(75,165) <> 2 THEN F$ = F$ + " LINE-LAST"
100 PSET (50.4,150.6),1 : PSET STEP(1.4,0),2 : IF POINT(51,151) <> 2 THEN F$ = F$ + " PSET#"
110 PSET (250,150) : CIRCLE STEP(0,0),10,1 : IF POINT(260,150) <> 1 THEN F$ = F$ + " CIRCLE-STEP"
120 REM DRAW angles: in 320x200, A1 turns R10 into a move of 8 pixels up
130 DRAW "C3 BM50,50 A1 R10" : IF POINT(0) <> 50 OR POINT(1) <> 42 OR POINT(50,46) <> 3 THEN F$ = F$ + " A1"
140 DRAW "BM100,50 A2 R10" : IF POINT(0) <> 90 OR POINT(1) <> 50 THEN F$ = F$ + " A2"
150 DRAW "BM120,50 A3 R10" : IF POINT(0) <> 120 OR POINT(1) <> 58 THEN F$ = F$ + " A3"
160 DRAW "BM150,50 TA90 R10" : IF POINT(0) <> 150 OR POINT(1) <> 42 THEN F$ = F$ + " TA90"
170 DRAW "BM180,50 TA45 R10" : IF POINT(0) <> 187 OR POINT(1) <> 44 THEN F$ = F$ + " TA45"
180 DRAW "BM210,50 TA-90 R10" : IF POINT(0) <> 210 OR POINT(1) <> 58 THEN F$ = F$ + " TA-90"
190 DRAW "TA0;"
200 A$ = "R5;" : DRAW "BM10,100 XA$;" : IF POINT(0) <> 15 OR POINT(1) <> 100 THEN F$ = F$ + " X"
210 B$ = "XA$;D5" : DRAW "BM10,120 XB$;" : IF POINT(0) <> 15 OR POINT(1) <> 125 THEN F$ = F$ + " XX"
220 DRAW "BM200,100 C3 R10 D10 L10 U10 BM205,105 P2,3"
230 IF POINT(205,105) <> 2 OR POINT(200,100) <> 3 THEN F$ = F$ + " P"
240 DIM D#(30) : GET (200,100)-(210,110),D#
250 PUT (100,150),D#,PSET : IF POINT(105,155) <> 2 OR POINT(100,150) <> 3 THEN F$ = F$ + " PUT#"
260 DIM I%(30) : GET (200,100)-(210,110),I%
270 IF I%(0) <> 22 OR I%(1) <> 11 THEN F$ = F$ + " GET%"
280 PLAY "T255;L64;C;" : P$ = "D;" : PLAY "XP$;E"
290 REM VIEW: points are relative to the viewport (unless SCREEN), and drawing is clipped to it
300 CLS : VIEW SCREEN (100,50)-(199,149),1,2 : PSET (90,60),3 : IF POINT(100,50) <> 1 OR POINT(99,49) <> -1 THEN F$ = F$ + " VIEW-SCREEN"
310 VIEW : IF POINT(99,49) <> 2 OR POINT(90,60) <> 0 THEN F$ = F$ + " VIEW-CLIP"
320 VIEW (100,50)-(199,149) : PSET (10,10),3 : IF POINT(10,10) <> 3 OR POINT(0) <> 10 OR POINT(1) <> 10 THEN F$ = F$ + " VIEW"
330 LINE (-10,50)-(150,50),3 : DRAW "BM20,30" : IF POINT(0) <> 20 OR POINT(1) <> 30 THEN F$ = F$ + " VIEW-DRAW"
340 VIEW : IF POINT(110,60) <> 3 OR POINT(100,100) <> 3 OR POINT(99,100) <> 2 OR POINT(201,100) <> 0 THEN F$ = F$ + " VIEW-LINE"
350 REM WINDOW: world coordinates (y increases upward, unless WINDOW SCREEN)
360 WINDOW (0,0)-(319,199) : PSET (10,10),3 : IF POINT(0) <> 10 OR POINT(1) <> 189 OR POINT(3) <> 10 OR PMAP(10,1) <> 189 OR PMAP(189,3) <> 10 THEN F$ = F$ + " WINDOW"
370 DRAW "BM100,100" : PSET STEP(1,1),2 : IF POINT(0) <> 101 OR POINT(1) <> 99 THEN F$ = F$ + " WINDOW-STEP"
380 VIEW SCREEN (0,0)-(128,128) : WINDOW SCREEN (0,0)-(2,2) : PSET (1,1),2 : PSET STEP(.5,.25),1
390 IF POINT(1,1) <> 2 OR POINT(0) <> 96 OR POINT(1) <> 80 OR POINT(2) <> 2 OR POINT(3) <> 1 THEN F$ = F$ + " WINDOW-SCREEN"
400 IF PMAP(1.5,0) <> 96 OR PMAP(80,3) <> 1.25 THEN F$ = F$ + " PMAP"
405 CIRCLE (1,1),.5,3 : CIRCLE (1,1),1,2 : WINDOW : IF POINT(96,64) <> 3 OR POINT(128,64) <> 2 THEN F$ = F$ + " CIRCLE-WINDOW"
410 VIEW (100,50)-(200,150) : WINDOW (-1,-1)-(1,1) : PSET (0,0),3 : IF POINT(0) <> 50 OR POINT(1) <> 50 OR PMAP(0,0) <> 50 THEN F$ = F$ + " VIEW-WINDOW"
420 VIEW SCREEN (0,0)-(100,100) : PSET (1,1),3 : IF POINT(0) <> 100 OR POINT(1) <> 0 THEN F$ = F$ + " VIEW-RESCALE"
430 WINDOW : VIEW : PSET (5,5),1 : IF POINT(5,5) <> 1 OR POINT(0) <> 5 THEN F$ = F$ + " WINDOW-OFF"
433 LINE (10,170)-(30,190),3,B : PAINT (20,180),CHR$(&H19)+CHR$(&H24),3 : IF POINT(13,180) <> 1 OR POINT(14,180) <> 2 OR POINT(13,181) <> 2 OR POINT(14,181) <> 1 OR POINT(29,189) <> 2 OR POINT(31,180) <> 0 THEN F$ = F$ + " PAINT-TILE"
436 LINE (40,170)-(60,190),3,B : PAINT (50,180),CHR$(&H55)+CHR$(0),3 : IF POINT(50,188) <> 1 OR POINT(50,172) <> 1 OR POINT(50,181) <> 0 THEN F$ = F$ + " PAINT-BACK"
440 SCREEN 0
450 IF F$ <> "" THEN PRINT "Failed:";F$ : PRINT "GFXTEST failed" ELSE PRINT "GFXTEST passed"
460 WHILE INKEY$ = "" : WEND
