10 REM Run by IOERR.COM: test-only IOCTLs arm one DOS error or short write
20 ON ERROR GOTO 9000
30 OPEN "IOERR.TMP" FOR OUTPUT AS #1
40 PRINT #1, "abc";
50 CLOSE #1
60 OPEN "IOERR.TMP" FOR RANDOM AS #1 LEN=8
70 FIELD #1, 8 AS S$
80 GET #1, 1
90 IF S$ <> "abc"+STRING$(5,0) THEN PRINT "partial GET failed" : FAILS=FAILS+1
100 GET #1, 2
110 IF S$ <> STRING$(8,0) THEN PRINT "EOF GET failed" : FAILS=FAILS+1
120 LSET S$="Original" : PUT #1, 1
130 T=1 : E=0 : IOCTL #1,240,1
140 GET #1, 2
150 IF E<>57 OR LOC(1)<>1 OR S$<>"Original" THEN PRINT "GET seek error failed" : FAILS=FAILS+1
160 T=2 : E=0 : IOCTL #1,240,2
170 GET #1, 1
180 IF E<>57 OR LOC(1)<>1 OR S$<>"Original" THEN PRINT "GET read error failed" : FAILS=FAILS+1
190 T=3 : E=0 : IOCTL #1,240,3
200 PUT #1, 2
210 IF E<>57 OR LOC(1)<>1 THEN PRINT "PUT error failed" : FAILS=FAILS+1
220 T=4 : E=0 : IOCTL #1,240,4
230 PUT #1, 2
240 IF E<>61 OR LOC(1)<>1 THEN PRINT "short PUT failed" : FAILS=FAILS+1
250 T=0 : PUT #1
260 IF LOC(1)<>2 OR LOF(1)<>16 THEN PRINT "PUT recovery failed" : FAILS=FAILS+1
270 T=5 : E=0 : IOCTL #1,240,5
280 CLOSE #1
290 IF E<>57 THEN PRINT "CLOSE error failed" : FAILS=FAILS+1
300 T=0 : CLOSE #1
310 OPEN "IOERR.TMP" FOR RANDOM AS #1 LEN=8
320 OPEN "NUL" FOR INPUT AS #2
330 T=6 : E=0 : IOCTL #1,240,5
340 CLOSE
350 IF E<>57 THEN PRINT "CLOSE all error failed" : FAILS=FAILS+1
360 T=0 : CLOSE #1 : CLOSE #2
370 OPEN "NUL" FOR INPUT AS #1
380 T=0 : IOCTL #1,241,FAILS
390 CLOSE
400 DEL IOERR.TMP
410 IF FAILS THEN PRINT "IOERR BASIC failed" ELSE PRINT "IOERR BASIC passed"
420 END
9000 E=ERR
9010 IF T=1 THEN RESUME 150
9020 IF T=2 THEN RESUME 180
9030 IF T=3 THEN RESUME 210
9040 IF T=4 THEN RESUME 240
9050 IF T=5 THEN RESUME 290
9060 IF T=6 THEN RESUME 350
9070 PRINT "Unexpected IOERR error";ERR : RESUME 420
