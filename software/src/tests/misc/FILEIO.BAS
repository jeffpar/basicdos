10 REM FILEIO.BAS: BASIC-DOS file I/O tests (prints "failed" on error)
20 REM Sequential files: PRINT #, WRITE #, INPUT #, LINE INPUT #, EOF, APPEND
30 OPEN "FT1.DAT" FOR OUTPUT AS #1
40 PRINT #1, "Hello"; 42
50 PRINT #1, 1; -2; 3.5
60 WRITE #1, "a,b", 1.5, -7, ""
70 PRINT #1, "last line"
80 CLOSE #1
90 OPEN "FT1.DAT" FOR INPUT AS #1
100 LINE INPUT #1, L$
110 IF L$ <> "Hello 42 " THEN PRINT "LINE INPUT # failed" : FAILS = FAILS + 1
120 INPUT #1, A, B, C
130 IF A <> 1 OR B <> -2 OR C <> 3.5 THEN PRINT "INPUT # numbers failed" : FAILS = FAILS + 1
140 INPUT #1, S$, X, Y, E$
150 IF S$ <> "a,b" OR X <> 1.5 OR Y <> -7 OR E$ <> "" THEN PRINT "INPUT # WRITE items failed" : FAILS = FAILS + 1
160 IF EOF(1) THEN PRINT "EOF early failed" : FAILS = FAILS + 1
170 LINE INPUT #1, L$
180 IF L$ <> "last line" THEN PRINT "LINE INPUT # last failed" : FAILS = FAILS + 1
190 IF NOT EOF(1) THEN PRINT "EOF failed" : FAILS = FAILS + 1
200 CLOSE
210 OPEN "FT1.DAT" FOR APPEND AS 2
220 PRINT #2, "more"
230 CLOSE 2
240 N = 0 : S = 0
250 OPEN "FT1.DAT" FOR INPUT AS 1
260 WHILE NOT EOF(1)
270 LINE INPUT #1, L$
280 N = N + 1 : S = S + LEN(L$) + 2
290 WEND
300 IF N <> 5 OR L$ <> "more" THEN PRINT "APPEND failed" : FAILS = FAILS + 1
310 IF LOF(1) <> S THEN PRINT "LOF failed" : FAILS = FAILS + 1
320 CLOSE 1
330 GOSUB 2000
400 REM Errors
410 ON ERROR GOTO 1000
420 OPEN "NOPE.DAT" FOR INPUT AS 1
430 IF E <> 53 THEN PRINT "File not found failed" : FAILS = FAILS + 1
440 ON ERROR GOTO 1010
450 PRINT #3, "x"
460 IF E <> 52 THEN PRINT "Bad file number failed" : FAILS = FAILS + 1
470 OPEN "FT1.DAT" FOR INPUT AS 1
480 ON ERROR GOTO 1020
490 PRINT #1, "x"
500 IF E <> 54 THEN PRINT "Bad file mode failed" : FAILS = FAILS + 1
510 ON ERROR GOTO 1030
520 LINE INPUT #1, L$
530 GOTO 520
540 IF E <> 62 THEN PRINT "Input past end failed" : FAILS = FAILS + 1
550 ON ERROR GOTO 0
560 CLOSE
600 REM Random access files: FIELD, LSET, RSET, PUT #, GET #, LOC, LOF
610 OPEN "FT2.DAT" FOR RANDOM AS #1 LEN = 20
620 FIELD #1, 10 AS N$, 4 AS I$, 2 AS J$, 4 AS K$
630 FOR R = 1 TO 3
640 LSET N$ = "Name" + STR$(R)
650 LSET I$ = MKL$(R * 1000)
660 LSET J$ = MKI$(-R)
670 RSET K$ = "x"
680 PUT #1, R
690 NEXT R
700 IF LOF(1) <> 60 THEN PRINT "PUT # failed" : FAILS = FAILS + 1
710 GET #1, 2
720 IF N$ <> "Name 2    " OR CVL(I$) <> 2000 OR CVI(J$) <> -2 OR K$ <> "   x" THEN PRINT "GET # failed" : FAILS = FAILS + 1
730 IF LOC(1) <> 2 THEN PRINT "LOC failed" : FAILS = FAILS + 1
740 GET #1
750 IF CVL(I$) <> 3000 OR LOC(1) <> 3 THEN PRINT "GET # next failed" : FAILS = FAILS + 1
760 LSET N$ = "Changed" : REM (I$ is still from record 3)
770 PUT #1, 1
780 GET #1, 1
790 IF N$ <> "Changed   " OR CVL(I$) <> 3000 THEN PRINT "PUT # update failed" : FAILS = FAILS + 1
800 CLOSE #1
810 OPEN "FT2.DAT" AS #2 LEN = 20
820 FIELD #2, 20 AS R$
830 GET #2, 3
840 IF LEN(R$) <> 20 OR LEFT$(R$, 6) <> "Name 3" THEN PRINT "OPEN AS failed" : FAILS = FAILS + 1
850 CLOSE
860 D$ = MKD$(1.5)
870 IF LEN(D$) <> 8 OR CVD(D$) <> 1.5 THEN PRINT "MKD$/CVD failed" : FAILS = FAILS + 1
880 IF CVI(MKI$(32767)) <> 32767 OR CVL(MKL$(-123456)) <> -123456 THEN PRINT "MKI$/MKL$ failed" : FAILS = FAILS + 1
890 A$ = "abc"
900 LSET A$ = "xy"
910 IF A$ <> "xy " THEN PRINT "LSET failed" : FAILS = FAILS + 1
920 RSET A$ = "z"
930 IF A$ <> "  z" THEN PRINT "RSET failed" : FAILS = FAILS + 1
940 DEL FT1.DAT
950 DEL FT2.DAT
960 IF FAILS THEN PRINT "FILEIO failed" ELSE PRINT "FILEIO passed"
970 END
1000 E = ERR : RESUME 430
1010 E = ERR : RESUME 460
1020 E = ERR : RESUME 500
1030 E = ERR : RESUME 540
2000 REM CRLF at and across the 255-byte read boundary, including a real blank line
2010 FOR N = 253 TO 254
2020 P$ = STRING$(N, "x")
2030 OPEN "FT3.DAT" FOR OUTPUT AS #1
2040 PRINT #1, P$
2050 PRINT #1, ""
2060 PRINT #1, "tail"
2070 CLOSE #1
2080 OPEN "FT3.DAT" FOR INPUT AS #1
2090 LINE INPUT #1, L$
2100 IF L$ <> P$ THEN PRINT "LINE INPUT # boundary data failed" : FAILS = FAILS + 1
2110 LINE INPUT #1, L$
2120 IF L$ <> "" THEN PRINT "LINE INPUT # boundary blank failed" : FAILS = FAILS + 1
2130 LINE INPUT #1, L$
2140 IF L$ <> "tail" OR NOT EOF(1) THEN PRINT "LINE INPUT # boundary CRLF failed" : FAILS = FAILS + 1
2150 CLOSE #1
2160 NEXT N
2170 REM A boundary CR followed by text, CTRLZ, or EOF must preserve the next byte
2180 FOR T = 0 TO 2
2190 P$ = STRING$(254, "r")
2200 OPEN "FT3.DAT" FOR OUTPUT AS #1
2210 PRINT #1, P$; CHR$(13);
2220 IF T = 0 THEN PRINT #1, "tail";
2230 IF T = 1 THEN PRINT #1, CHR$(26); "junk";
2240 CLOSE #1
2250 OPEN "FT3.DAT" FOR INPUT AS #1
2260 LINE INPUT #1, L$
2270 IF L$ <> P$ THEN PRINT "LINE INPUT # boundary CR data failed" : FAILS = FAILS + 1
2280 IF T = 0 THEN LINE INPUT #1, L$
2290 IF T = 0 AND L$ <> "tail" THEN PRINT "LINE INPUT # boundary CR text failed" : FAILS = FAILS + 1
2300 IF NOT EOF(1) THEN PRINT "LINE INPUT # boundary CR EOF failed" : FAILS = FAILS + 1
2310 CLOSE #1
2320 NEXT T
2330 REM INPUT # shares CRLF handling; follow quoted and unquoted items with LINE INPUT
2340 FOR T = 0 TO 1
2350 P$ = STRING$(254 - 2 * T, "q")
2360 OPEN "FT3.DAT" FOR OUTPUT AS #1
2370 IF T = 0 THEN PRINT #1, P$
2380 IF T = 1 THEN PRINT #1, CHR$(34); P$; CHR$(34)
2390 PRINT #1, "tail"
2400 CLOSE #1
2410 OPEN "FT3.DAT" FOR INPUT AS #1
2420 INPUT #1, S$
2430 LINE INPUT #1, L$
2440 IF S$ <> P$ OR L$ <> "tail" OR NOT EOF(1) THEN PRINT "INPUT # boundary CRLF failed" : FAILS = FAILS + 1
2450 CLOSE #1
2460 NEXT T
2470 DEL FT3.DAT
2480 RETURN
