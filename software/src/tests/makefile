BIN\PRIMES.EXE: PRIMES\PRIMES.ASM OBJ\INCS
	$(ASM) $(AFLAGS) PRIMES\$*.ASM,BIN\$*.OBJ,$(LST);
	$(LINK) BIN\$*.OBJ,BIN\$*.EXE;
	DEL BIN\$*.OBJ

OBJ\BDLIB.OBJ: LIB\BDLIB.ASM OBJ\INCS
	$(ASM) $(AFLAGS) LIB\$*.ASM,OBJ\$*.OBJ,$(LST);

OBJ\SPRINTF.OBJ: ..\OS\DOS\SPRINTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) ..\OS\DOS\$*.ASM,OBJ\$*.OBJ,$(LST);

OBJ\PRINTF.OBJ: PRINTF\PRINTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) PRINTF\$*.ASM,OBJ\$*.OBJ,$(LST);

BIN\PRINTF.COM: OBJ\BDLIB.OBJ OBJ\SPRINTF.OBJ OBJ\PRINTF.OBJ
	$(LINK) /MAP OBJ\BDLIB.OBJ+OBJ\SPRINTF.OBJ+OBJ\PRINTF.OBJ,OBJ\PRINTF.EXE,OBJ\PRINTF.MAP;
	$(EXE2BIN) OBJ\PRINTF.EXE $@
	CD OBJ
	$(MAPSYM) PRINTF.MAP
	DEL PRINTF.EXE
	CD ..
