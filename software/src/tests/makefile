ASM=MASM
LINK=LINK
EXE2BIN=EXE2BIN
MAPSYM=MAPSYM
AFLAGS=/MX /R /D$(REL) /I..\OS\INC
#
# Use LST=NUL to turn listings off and LST=OBJ\$*.LST to turn them on.
#
LST=NUL

#
# Every module depends on OBJ\INCS, an empty file that's re-created whenever
# any include file changes, so that every module is rebuilt then, too (MAKE
# has no pseudo-targets, and MS-DOS's COPY would keep the old file's time).
#
OBJ\INCS: ..\OS\INC\8086.INC ..\OS\INC\BIOS.INC ..\OS\INC\CPU.INC \
	..\OS\INC\DEV.INC ..\OS\INC\DEVAPI.INC ..\OS\INC\DISK.INC \
	..\OS\INC\DOS.INC ..\OS\INC\DOSAPI.INC ..\OS\INC\FPU.INC \
	..\OS\INC\MACROS.INC ..\OS\INC\PARSER.INC ..\OS\INC\UART.INC \
	..\OS\INC\UTIL.INC ..\OS\INC\VERSION.INC
	TYPE NUL > OBJ\INCS

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.COM:
	$(ASM) $(AFLAGS) $**,$*.OBJ,$(LST);
	$(LINK) $*.OBJ,$*.EXE;
	$(EXE2BIN) $*.EXE $@
	DEL $*.OBJ
	DEL $*.EXE

.ASM.EXE:
	$(ASM) $(AFLAGS) $**,$*.OBJ,$(LST);
	$(LINK) $*.OBJ,$*.EXE;
	DEL $*.OBJ

BIN\DISKREAD.COM: MISC\DISKREAD.ASM OBJ\INCS
	$(ASM) $(AFLAGS) MISC\$*.ASM,BIN\$*.OBJ,$(LST);
	$(LINK) BIN\$*.OBJ,BIN\$*.EXE;
	$(EXE2BIN) BIN\$*.EXE $@
	DEL BIN\$*.OBJ
	DEL BIN\$*.EXE

BIN\DISKWRIT.COM: MISC\DISKWRIT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) MISC\$*.ASM,BIN\$*.OBJ,$(LST);
	$(LINK) BIN\$*.OBJ,BIN\$*.EXE;
	$(EXE2BIN) BIN\$*.EXE $@
	DEL BIN\$*.OBJ
	DEL BIN\$*.EXE

BIN\ASSERT.COM: MISC\ASSERT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) MISC\$*.ASM,BIN\$*.OBJ,$(LST);
	$(LINK) BIN\$*.OBJ,BIN\$*.EXE;
	$(EXE2BIN) BIN\$*.EXE $@
	DEL BIN\$*.OBJ
	DEL BIN\$*.EXE

