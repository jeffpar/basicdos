IF NOT EXIST REGRESS\OBJ\NUL MKDIR REGRESS\OBJ
IF NOT EXIST MISC\OBJ\NUL MKDIR MISC\OBJ
IF NOT EXIST TOOLS\OBJ\NUL MKDIR TOOLS\OBJ
