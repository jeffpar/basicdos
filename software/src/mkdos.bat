ECHO OFF
REM Use MKDOS FINAL to create a non-debug release
IF "%1"=="quit" QUIT
IF "%1"=="QUIT" QUIT
IF EXIST CLEAN MKCLEAN %1
CD OS\BOOT
IF "%1"=="" IF EXIST ..\..\MKFINAL MKDOS FINAL ALL
IF "%1"=="" MKDOS DEBUG ALL
IF "%1"=="debug" MKDOS DEBUG ALL
IF "%1"=="DEBUG" MKDOS DEBUG ALL
IF "%1"=="final" MKDOS FINAL ALL
IF "%1"=="FINAL" MKDOS FINAL ALL
CD ..\..
ECHO Usage: MKDOS [DEBUG or FINAL]
