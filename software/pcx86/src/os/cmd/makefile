ASM=MASM
LINK=LINK
EXE2BIN=EXE2BIN
AFLAGS=/MX /R /D$(REL) /I. /I..\INC

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.OBJ:
	$(ASM) $(AFLAGS) $*.ASM,$@;

.ASM.LST:
	$(ASM) $(AFLAGS) $*.ASM,$.OBJ,$@;

OBJ\RES.OBJ: RES.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\CMD.OBJ: CMD.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENCMD.OBJ: GENCMD.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENEXP.OBJ: GENEXP.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENFLO.OBJ: GENFLO.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENCON.OBJ: GENCON.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENFPU.OBJ: GENFPU.ASM CMD.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENDEF.OBJ: GENDEF.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENSYS.OBJ: GENSYS.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GENGFX.OBJ: GENGFX.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\ARR.OBJ: ARR.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\FLOW.OBJ: FLOW.ASM CMD.INC ..\INC\FPU.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GFX.OBJ: GFX.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\GFXCIRC.OBJ: GFXCIRC.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\LIBC.OBJ: LIBC.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\LONG.OBJ: LONG.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\MEM.OBJ: MEM.ASM CMD.INC ..\INC\DOS.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\STR.OBJ: STR.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\SYS.OBJ: SYS.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\VAR.OBJ: VAR.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\CONST.OBJ: CONST.ASM CMD.INC
	$(ASM) $(AFLAGS) $*.ASM,$@;

OBJ\COMMAND.COM: OBJ\RES.OBJ OBJ\CMD.OBJ OBJ\GENCMD.OBJ OBJ\GENEXP.OBJ OBJ\GENFLO.OBJ OBJ\GENCON.OBJ \
	OBJ\GENFPU.OBJ OBJ\GENDEF.OBJ OBJ\GENSYS.OBJ OBJ\GENGFX.OBJ \
	OBJ\ARR.OBJ OBJ\FLOW.OBJ OBJ\GFX.OBJ OBJ\GFXCIRC.OBJ \
	OBJ\LIBC.OBJ OBJ\LONG.OBJ \
	OBJ\MEM.OBJ OBJ\STR.OBJ OBJ\SYS.OBJ OBJ\VAR.OBJ OBJ\CONST.OBJ \
	COMMAND.LRF
	$(LINK) @$*.LRF
	$(EXE2BIN) OBJ\$*.EXE $@
	DEL OBJ\$*.EXE
