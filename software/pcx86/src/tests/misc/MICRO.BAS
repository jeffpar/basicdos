5 REM MICRO.BAS: per-operation timings (in BIOS ticks) for BASIC-DOS, BASICA, and GW-BASIC
10 DEFINT I-N:DEFDBL A-H,O-Z
20 DIM R(21):DEF SEG=0:Q=0:Y=1.0001#:X=1#:Z=.5#:B$="HELLO":C$="WORLD"
100 GOSUB 9000:FOR I=1 TO 1000:NEXT:GOSUB 9100
110 GOSUB 9000:FOR I=1 TO 1000:X=Y:NEXT:GOSUB 9100
120 GOSUB 9000:FOR I=1 TO 1000:X=Y+Z:NEXT:GOSUB 9100
130 GOSUB 9000:FOR I=1 TO 1000:X=Y*Z:NEXT:GOSUB 9100
140 GOSUB 9000:FOR I=1 TO 1000:X=Y/Z:NEXT:GOSUB 9100
150 GOSUB 9000:FOR I=1 TO 1000:X=I:NEXT:GOSUB 9100
160 GOSUB 9000:FOR I=1 TO 1000:J=Y:NEXT:GOSUB 9100
170 GOSUB 9000:FOR I=1 TO 1000:K=X>Y:NEXT:GOSUB 9100
200 GOSUB 9000:FOR I=1 TO 100:X=SQR(Y):NEXT:GOSUB 9100
210 GOSUB 9000:FOR I=1 TO 100:X=SIN(Y):NEXT:GOSUB 9100
220 GOSUB 9000:FOR I=1 TO 100:X=COS(Y):NEXT:GOSUB 9100
230 GOSUB 9000:FOR I=1 TO 100:X=ATN(Y):NEXT:GOSUB 9100
240 GOSUB 9000:FOR I=1 TO 100:X=LOG(Y):NEXT:GOSUB 9100
250 GOSUB 9000:FOR I=1 TO 100:X=EXP(Y):NEXT:GOSUB 9100
300 GOSUB 9000:FOR I=1 TO 1000:A$=STR$(I):NEXT:GOSUB 9100
310 GOSUB 9000:FOR I=1 TO 1000:A$=B$+C$:NEXT:GOSUB 9100
320 GOSUB 9000:FOR I=1 TO 1000:A$=LEFT$(B$,2):NEXT:GOSUB 9100
330 GOSUB 9000:FOR I=1 TO 1000:A$=MID$(B$,2,3):NEXT:GOSUB 9100
340 GOSUB 9000:FOR I=1 TO 1000:K=LEN(B$)+ASC(B$):NEXT:GOSUB 9100
350 GOSUB 9000:FOR I=1 TO 1000:K=INSTR(B$,"L"):NEXT:GOSUB 9100
360 GOSUB 9000:FOR I=1 TO 1000:A$=B$:NEXT:GOSUB 9100
1000 PRINT:FOR I=1 TO Q:PRINT "T";I;R(I):NEXT
1010 END
9000 T0=PEEK(&H46C)
9010 IF PEEK(&H46C)=T0 THEN 9010
9020 T0=PEEK(&H46C)+256*PEEK(&H46D):RETURN
9100 T1=PEEK(&H46C)+256*PEEK(&H46D):Q=Q+1:R(Q)=T1-T0
9110 IF R(Q)<0 THEN R(Q)=R(Q)+65536
9115 PRINT Q;R(Q);
9120 RETURN
