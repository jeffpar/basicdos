#
# Builds HELLOC.EXE, the program that MAKEFILE builds (HELLO.EXE), but
# compiled with CL386 (the Microsoft 386 C Compiler) as a 32-bit LE program,
# which BASIC-DOS runs on an 80386 in protected mode.
#
# Run "MAKE MAKE386" in this folder, with TOOLS\BIN in PATH$, in protected
# mode (CL386 and LINK386 are OS/2 programs).  The steps are:
#
#   1. CL386 compiles HELLO.C (/c means compile only, since CL386 would run
#      LINK386) to HELLOC.OBJ (/Fo names the object file, so that it doesn't
#      replace MAKEFILE's).  /I names the 386 compiler's include folder,
#      whose files are its own, not those of Microsoft C 4.00.
#
#   2. LINK386 links BDCRT386.OBJ (the BASIC-DOS startup code, which must be
#      the first object file) and HELLOC.OBJ with the 386 compiler's library,
#      all in ..\..\LIB\386, making an LE program, as HELLOC.DEF asks.
#
helloc.obj: hello.c
	cl386 /c /I..\..\include\386 /Fohelloc.obj hello.c

helloc.exe: helloc.obj helloc.def
	link386 /NOE ..\..\lib\386\bdcrt386 helloc,helloc,nul,..\..\lib\386\,helloc.def
