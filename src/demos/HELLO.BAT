@ECHO OFF
REM Colors that an MDA can show: 2-7 normal, 9 underlined, 10-15 bright
PRINT "    ";:S$="HAPPY":C=2:F=2:T=7:GOSUB 10
PRINT "   ";:S$="BASIC":C=10:F=10:T=14:K=16:GOSUB 10:PRINT
PRINT "    ";:S$="PROGRAMMING":C=2:F=2:T=7:K=0:GOSUB 10:PRINT
PRINT "    ";:S$="LOVE,":GOSUB 10
PRINT "   ";:S$="PCJS.ORG":C=9:F=9:T=9:GOSUB 10:PRINT
COLOR 7,0:END
10 FOR I=1 TO LEN(S$)
COLOR C+K,0:PRINT MID$(S$,I,1);:IF I<LEN(S$) THEN PRINT " ";
C=C+1:IF C>T THEN C=F
NEXT I
RETURN
