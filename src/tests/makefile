#
# PRIMES.EXE is an NE program (see PRIMES.DEF) whose stub is the MS-DOS
# program that LINK builds (OBJ\PRIMES.EXE), so it runs in real mode, too.
#
MISC\OBJ\PRIMES.EXE: MISC\PRIMES.ASM MISC\PRIMES.DEF OBJ\INCS
	$(ASM) $(AFLAGS) MISC\$*.ASM,MISC\OBJ\$*.OBJ,$(LST);
	$(LINK) MISC\OBJ\$*.OBJ,OBJ\$*.EXE;
	$(LINK4) MISC\OBJ\$*.OBJ,$@/ALIGN:16,NUL,,MISC\$*.DEF;
	DEL MISC\OBJ\$*.OBJ
	DEL OBJ\$*.EXE

#
# The test tools (TOOLS on the disks).
