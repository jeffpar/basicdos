#
# MASM5 is MASM 5.10B; use ASM=MASM on MAKE's command line to assemble with
# MASM 4.00 instead.
#
ASM=MASM5
LINK=LINK
#
# LINK4 builds NE programs (see PRIMES.EXE below).
#
LINK4=LINK4
EXE2BIN=EXE2BIN
MAPSYM=MAPSYM
AFLAGS=/MX /R /D$(REL) /I..\OS\INC
#
# Use LST=NUL to turn listings off and LST=OBJ\$*.LST to turn them on.
#
LST=NUL

#
# Every module depends on OBJ\INCS, an empty file that's re-created whenever
# any include file changes, so that every module is rebuilt then, too (MAKE
# has no pseudo-targets, and MS-DOS's COPY would keep the old file's time).
# The exception is VERSION.INC: only the modules that include it depend on
# it, so that a new version rebuilds only those.
#
OBJ\INCS: ..\OS\INC\8086.INC ..\OS\INC\BIOS.INC ..\OS\INC\CPU.INC \
	..\OS\INC\DEV.INC ..\OS\INC\DEVAPI.INC ..\OS\INC\DISK.INC \
	..\OS\INC\DOS.INC ..\OS\INC\DOSAPI.INC ..\OS\INC\FPU.INC \
	..\OS\INC\MACROS.INC ..\OS\INC\OS2.INC ..\OS\INC\PARSER.INC \
	..\OS\INC\UART.INC ..\OS\INC\UTIL.INC
	TYPE NUL > OBJ\INCS

#
# Inference rules in the DOS MAKE utility apparently work only if the files
# are in the same folder.  So for now, each dependency must copy these rules.
#
.ASM.COM:
	$(ASM) $(AFLAGS) $**,$*.OBJ,$(LST);
	$(LINK) $*.OBJ,$*.EXE;
	$(EXE2BIN) $*.EXE $@
	DEL $*.OBJ
	DEL $*.EXE

.ASM.EXE:
	$(ASM) $(AFLAGS) $**,$*.OBJ,$(LST);
	$(LINK) $*.OBJ,$*.EXE;
	DEL $*.OBJ

#
# The regression tests (TESTS\REGRESS on the disks).
#
REGRESS\OBJ\BUFTESTS.COM: REGRESS\BUFTESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\CPUTESTS.COM: REGRESS\CPUTESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

#
# DLLTESTS.EXE is an NE program (see DLLTESTS.DEF) that imports functions
# from DOSCALLS.DLL; its stub is the same source assembled with STUB defined,
# which LINK builds as an MS-DOS program (OBJ\DLLTESTS.EXE).
#
REGRESS\OBJ\DLLTESTS.EXE: REGRESS\DLLTESTS.ASM REGRESS\DLLTESTS.DEF OBJ\INCS
	$(ASM) $(AFLAGS) /DSTUB REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,OBJ\$*.EXE;
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK4) REGRESS\OBJ\$*.OBJ,$@/ALIGN:16,NUL,,REGRESS\$*.DEF;
	DEL REGRESS\OBJ\$*.OBJ
	DEL OBJ\$*.EXE

REGRESS\OBJ\DOSTESTS.COM: REGRESS\DOSTESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\FCBTESTS.COM: REGRESS\FCBTESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\FPUTESTS.COM: REGRESS\FPUTESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\HARDERR.COM: REGRESS\HARDERR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\IOERR.COM: REGRESS\IOERR.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

REGRESS\OBJ\R3TESTS.COM: REGRESS\R3TESTS.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);
	$(LINK) REGRESS\OBJ\$*.OBJ,REGRESS\OBJ\$*.EXE;
	$(EXE2BIN) REGRESS\OBJ\$*.EXE $@
	DEL REGRESS\OBJ\$*.OBJ
	DEL REGRESS\OBJ\$*.EXE

OBJ\BDLIB.OBJ: LIB\BDLIB.ASM OBJ\INCS
	$(ASM) $(AFLAGS) LIB\$*.ASM,OBJ\$*.OBJ,$(LST);

OBJ\SPRINTF.OBJ: ..\OS\DOS\SPRINTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) ..\OS\DOS\$*.ASM,OBJ\$*.OBJ,$(LST);

REGRESS\OBJ\PRINTF.OBJ: REGRESS\PRINTF.ASM OBJ\INCS
	$(ASM) $(AFLAGS) REGRESS\$*.ASM,REGRESS\OBJ\$*.OBJ,$(LST);

REGRESS\OBJ\PRINTF.COM: OBJ\BDLIB.OBJ OBJ\SPRINTF.OBJ REGRESS\OBJ\PRINTF.OBJ
	$(LINK) /MAP OBJ\BDLIB.OBJ+OBJ\SPRINTF.OBJ+REGRESS\OBJ\PRINTF.OBJ,REGRESS\OBJ\PRINTF.EXE,REGRESS\OBJ\PRINTF.MAP;
	$(EXE2BIN) REGRESS\OBJ\PRINTF.EXE $@
	CD REGRESS\OBJ
	$(MAPSYM) PRINTF.MAP
	DEL PRINTF.EXE
	CD ..\..

#
# The other test programs (TESTS\MISC on the disks).
#
MISC\OBJ\ASSERT.COM: MISC\ASSERT.ASM OBJ\INCS
	$(ASM) $(AFLAGS) MISC\$*.ASM,MISC\OBJ\$*.OBJ,$(LST);
	$(LINK) MISC\OBJ\$*.OBJ,MISC\OBJ\$*.EXE;
	$(EXE2BIN) MISC\OBJ\$*.EXE $@
