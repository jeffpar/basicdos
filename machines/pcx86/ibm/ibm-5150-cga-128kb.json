{
  "name": "IBM PC, 128Kb RAM, Dual Floppy Drives, CGA",
  "defaults": {
    "ram": "128K",
    "fpu": "None",
    "fdc": "2 diskette drives",
    "parallel": "LPT1",
    "serial": "COM1"
  },
  "machine": {
    "type": "pcx86",
    "name": "PCx86",
    "version": "2.25",
    "factory": "embedPCx86"
  },
  "components": [
    {
      "id": "pcCGA",
      "class": "computer"
    },
    {
      "id": "debugger",
      "class": "debugger",
      "debug": true
    },
    {
      "id": "romBASIC",
      "class": "rom",
      "addr": "0xf6000",
      "size": "0x08000",
      "alias": null,
      "file": "/machines/pcx86/roms/BASIC100.json5"
    },
    {
      "id": "romBIOS",
      "class": "rom",
      "addr": "0xfe000",
      "size": "0x02000",
      "file": "/machines/pcx86/roms/PCBIOS-REV1.json5"
    },
    {
      "id": "videoCGA",
      "class": "video",
      "title": "Color Display",
      "screenWidth": 1280,
      "screenHeight": 800,
      "screenColor": "black",
      "charCols": 80,
      "charRows": 25,
      "fontROM": "/machines/pcx86/roms/IBM-CGA.json5",
      "flicker": 0,
      "overlay": true,
      "autoLock": true,
      "touchScreen": "mouse",
      "controls": [
        {
          "type": "group",
          "style": {
            "float": "right"
          }
        },
        {
          "id": "fullScreen",
          "type": "button",
          "label": "Full Screen",
          "style": {
            "padding-left": "8px",
            "line-height": "1em"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/fdc.json",
    "/machines/pcx86/ibm/ram-5150.json",
    {
      "id": "cpu8088",
      "class": "cpu",
      "model": 8088,
      "autoStart": true,
      "controls": [
        {
          "id": "reset",
          "type": "button",
          "label": "Reset",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/keys.json",
    "/machines/pcx86/ibm/panel.json",
    {
      "id": "chipset",
      "class": "chipset",
      "model": 5150,
      "scaleTimers": false,
      "sw1": "01001001",
      "sw2": "10111000",
      "@note": "The above switch settings indicate '128K, No FPU, Color Monitor, 2 Floppy Drives'; see 'swdesc' below.",
      "sound": true,
      "floppies": "",
      "monitor": "",
      "dateRTC": "",
      "controls": [
        {
          "type": "group",
          "debug": true,
          "style": {
            "float": "left",
            "padding-bottom": "8px",
            "padding-left": "8px"
          }
        },
        {
          "id": "sw1",
          "type": "switches",
          "debug": true,
          "title": "SW1",
          "style": {
            "position": "relative",
            "left": "0px"
          },
          "switches": [
            {
              "id": "sw1-1",
              "title": "Reserved",
              "label": "1",
              "value": 0
            },
            {
              "id": "sw1-2",
              "title": "FPU",
              "label": "2",
              "value": 1
            },
            {
              "id": "sw1-3",
              "title": "Base Memory (16K Increments)",
              "label": "3",
              "value": 0
            },
            {
              "id": "sw1-4",
              "title": "Base Memory (16K Increments)",
              "label": "4",
              "value": 0
            },
            {
              "id": "sw1-5",
              "title": "Monitor Type",
              "label": "5",
              "value": 1
            },
            {
              "id": "sw1-6",
              "title": "Monitor Type",
              "label": "6",
              "value": 0
            },
            {
              "id": "sw1-7",
              "title": "Number of Floppy Drives",
              "label": "7",
              "value": 0
            },
            {
              "id": "sw1-8",
              "title": "Number of Floppy Drives",
              "label": "8",
              "value": 1
            }
          ]
        },
        {
          "id": "sw2",
          "type": "switches",
          "debug": true,
          "title": "SW2",
          "style": {
            "position": "relative",
            "left": "0px",
            "clear": "both"
          },
          "switches": [
            {
              "id": "sw2-1",
              "title": "Expansion Memory (32K Increments)",
              "label": "1",
              "value": 1
            },
            {
              "id": "sw2-2",
              "title": "Expansion Memory (32K Increments)",
              "label": "2",
              "value": 1
            },
            {
              "id": "sw2-3",
              "title": "Expansion Memory (32K Increments)",
              "label": "3",
              "value": 1
            },
            {
              "id": "sw2-4",
              "title": "Expansion Memory (32K Increments)",
              "label": "4",
              "value": 1
            },
            {
              "id": "sw2-5",
              "title": "Expansion Memory (32K Increments)",
              "label": "5",
              "value": 1
            },
            {
              "id": "sw2-6",
              "title": "Reserved",
              "label": "6",
              "value": 0
            },
            {
              "id": "sw2-7",
              "title": "Reserved",
              "label": "7",
              "value": 0
            },
            {
              "id": "sw2-8",
              "title": "Reserved",
              "label": "8",
              "value": 0
            }
          ]
        },
        {
          "id": "swdesc",
          "type": "description",
          "debug": true,
          "label": "64K, No FPU, Color Monitor, 2 Floppy Drives",
          "style": {
            "position": "relative",
            "left": "0px",
            "clear": "both"
          }
        }
      ]
    },
    {
      "id": "lpt1",
      "class": "parallel",
      "adapter": 2,
      "binding": "print"
    },
    {
      "id": "com1",
      "class": "serial",
      "adapter": 1,
      "binding": "print"
    }
  ]
}
