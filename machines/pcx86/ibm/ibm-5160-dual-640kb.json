{
  "name": "IBM PC XT, 640Kb RAM, 10Mb Hard Disk, MDA and CGA",
  "defaults": {
    "ram": "640K",
    "fpu": "None",
    "fdc": "2 diskette drives",
    "parallel": "LPT1",
    "serial": "COM1",
    "hdc": "10Mb hard disk"
  },
  "machine": {
    "type": "pcx86",
    "class": "dual",
    "name": "PCx86",
    "version": "2.25",
    "factory": "embedPCx86"
  },
  "components": [
    {
      "id": "pcCGA",
      "class": "computer"
    },
    {
      "id": "debugger",
      "class": "debugger",
      "debug": true
    },
    {
      "id": "romBASIC",
      "class": "rom",
      "addr": "0xf6000",
      "size": "0x08000",
      "alias": null,
      "file": "/machines/pcx86/roms/BASIC110.json5"
    },
    {
      "id": "romBIOS",
      "class": "rom",
      "addr": "0xfe000",
      "size": "0x02000",
      "file": "/machines/pcx86/roms/XTBIOS-REV1.json5"
    },
    {
      "id": "romHDC",
      "class": "rom",
      "addr": "0xc8000",
      "size": "0x02000",
      "file": "/machines/pcx86/roms/IBM-XEBEC-1982.json5"
    },
    {
      "id": "videoMDA",
      "class": "video",
      "title": "Monochrome Display",
      "model": "mda",
      "screenWidth": 1440,
      "screenHeight": 900,
      "screenColor": "black",
      "charCols": 80,
      "charRows": 25,
      "fontROM": "/machines/pcx86/roms/IBM-MDA.json5",
      "overlay": true,
      "style": {
        "float": "left",
        "width": "49%",
        "clear": "none"
      },
      "controls": [
        {
          "type": "group",
          "style": {
            "float": "right"
          }
        },
        {
          "id": "fullScreen",
          "type": "button",
          "label": "Full Screen",
          "style": {
            "padding-left": "8px",
            "line-height": "1em"
          }
        }
      ]
    },
    {
      "id": "videoCGA",
      "class": "video",
      "title": "Color Display",
      "model": "cga",
      "screenWidth": 1280,
      "screenHeight": 800,
      "screenColor": "black",
      "charCols": 80,
      "charRows": 25,
      "fontROM": "/machines/pcx86/roms/IBM-CGA.json5",
      "flicker": 0,
      "overlay": true,
      "style": {
        "float": "right",
        "width": "49%",
        "clear": "none"
      },
      "controls": [
        {
          "type": "group",
          "style": {
            "float": "right"
          }
        },
        {
          "id": "fullScreen",
          "type": "button",
          "label": "Full Screen",
          "style": {
            "padding-left": "8px",
            "line-height": "1em"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/fdc.json",
    {
      "id": "ramLow",
      "class": "ram",
      "size": 655360,
      "test": "false",
      "controls": [
        {
          "id": "listSizes",
          "type": "list",
          "options": {
            "0": "Default",
            "16384": "16K",
            "32768": "32K",
            "49152": "48K",
            "65536": "64K",
            "98304": "96K",
            "131072": "128K",
            "163840": "160K",
            "196608": "192K",
            "229376": "224K",
            "262144": "256K",
            "294912": "288K",
            "327680": "320K",
            "360448": "352K",
            "393216": "384K",
            "425984": "416K",
            "458752": "448K",
            "491520": "480K",
            "524288": "512K",
            "557056": "544K",
            "589824": "576K",
            "622592": "608K",
            "655360": "640K"
          },
          "style": {
            "clear": "both",
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "cpu8088",
      "class": "cpu",
      "model": 8088,
      "autoStart": true,
      "controls": [
        {
          "id": "reset",
          "type": "button",
          "label": "Reset",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "hdcXT",
      "class": "hdc",
      "type": "XT",
      "drives": [
        {
          "name": "BASICDOS-HD",
          "type": 3,
          "path": "/software/pcx86/disks/BASICDOS-HD.json"
        }
      ],
      "controls": [
        {
          "id": "saveHD0",
          "type": "button",
          "label": "Save HD",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/keys.json",
    "/machines/pcx86/ibm/panel.json",
    {
      "id": "chipset",
      "class": "chipset",
      "model": 5160,
      "scaleTimers": false,
      "sw1": "01000001",
      "@note": "The above switch settings indicate '256K (on the system board), No FPU, Monochrome Monitor, 2 Floppy Drives'; ramLow sets the total (640K).",
      "sound": true,
      "floppies": "",
      "monitor": "",
      "dateRTC": ""
    },
    {
      "id": "lpt1",
      "class": "parallel",
      "adapter": 2,
      "binding": "print"
    },
    {
      "id": "com1",
      "class": "serial",
      "adapter": 1,
      "binding": "print"
    }
  ]
}
