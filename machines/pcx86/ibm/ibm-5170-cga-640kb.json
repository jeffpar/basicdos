{
  "name": "IBM PC AT, 640Kb RAM, 10Mb Hard Disk, CGA",
  "defaults": {
    "ram": "640K",
    "fpu": "None",
    "fdc": "2 1.2Mb diskette drives",
    "parallel": "LPT1",
    "serial": "COM1, COM2",
    "hdc": "10Mb hard disk"
  },
  "machine": {
    "type": "pcx86",
    "name": "PCx86",
    "version": "2.26",
    "factory": "embedPCx86"
  },
  "components": [
    {
      "id": "pcCGA",
      "class": "computer",
      "busWidth": 24
    },
    {
      "id": "debugger",
      "class": "debugger",
      "debug": true
    },
    {
      "id": "romBIOS",
      "class": "rom",
      "addr": "0xf0000",
      "size": "0x10000",
      "file": "/machines/pcx86/roms/ATBIOS-REV3.json5",
      "alias": "0xff0000"
    },
    {
      "id": "videoCGA",
      "class": "video",
      "title": "Color Display",
      "screenWidth": 1280,
      "screenHeight": 800,
      "screenColor": "black",
      "charCols": 80,
      "charRows": 25,
      "fontROM": "/machines/pcx86/roms/IBM-CGA.json5",
      "flicker": 0,
      "overlay": true,
      "controls": [
        {
          "type": "group",
          "style": {
            "float": "right"
          }
        },
        {
          "id": "fullScreen",
          "type": "button",
          "label": "Full Screen",
          "style": {
            "padding-left": "8px",
            "line-height": "1em"
          }
        }
      ]
    },
    {
      "id": "com1",
      "class": "serial",
      "adapter": 1
    },
    {
      "id": "com2",
      "class": "serial",
      "adapter": 2
    },
    {
      "id": "fdcNEC",
      "class": "fdc",
      "diskettes": "",
      "server": "",
      "style": {
        "float": "left",
        "padding-right": "8px",
        "padding-bottom": "8px"
      },
      "controls": [
        {
          "type": "group"
        },
        {
          "id": "listDrives",
          "type": "list"
        },
        {
          "id": "listDisks",
          "type": "list",
          "options": {
            "": "None",
            "/software/disks/BASICDOS-360K-S80.json": "BASICDOS-360K-S80",
            "/software/disks/BASICDOS-360K-D40.json": "BASICDOS-360K-D40",
            "/software/disks/BASICDOS-360K-D80.json": "BASICDOS-360K-D80",
            "/software/disks/BASICDOS-360K-P80.json": "BASICDOS-360K-P80",
            "/software/disks/BASICDOS-360K-DUAL.json": "BASICDOS-360K-DUAL",
            "/software/disks/BASICDOS-360K-MULTI.json": "BASICDOS-360K-MULTI",
            "/software/disks/BASICDOS-360K-SERIAL.json": "BASICDOS-360K-SERIAL",
            "/software/disks/BASICDOS-360K-VT100.json": "BASICDOS-360K-VT100",
            "/software/disks/BASICDOS-360K-DEBUG.json": "BASICDOS-360K-DEBUG",
            "/software/disks/BASICDOS-360K-TESTS.json": "BASICDOS-360K-TESTS",
            "/software/disks/PCDOS100.json": "PC DOS 1.00",
            "/software/disks/PCDOS110.json": "PC DOS 1.10",
            "/software/disks/PCDOS200-DISK1.json": "PC DOS 2.00 (Disk 1)",
            "/software/disks/PCDOS200-DISK2.json": "PC DOS 2.00 (Disk 2)"
          }
        },
        {
          "id": "loadDisk",
          "type": "button",
          "label": "Load"
        },
        {
          "id": "saveDisk",
          "type": "button",
          "label": "Save",
          "style": {
            "padding-right": "8px"
          }
        },
        {
          "id": "descDisk",
          "type": "description",
          "style": {
            "padding-right": "8px"
          }
        },
        {
          "id": "mountDisk",
          "type": "file",
          "label": "Mount"
        }
      ]
    },
    {
      "id": "ramLow",
      "class": "ram",
      "size": 655360,
      "test": "false",
      "controls": [
        {
          "id": "listSizes",
          "type": "list",
          "options": {
            "0": "Default",
            "16384": "16K",
            "32768": "32K",
            "49152": "48K",
            "65536": "64K",
            "98304": "96K",
            "131072": "128K",
            "163840": "160K",
            "196608": "192K",
            "229376": "224K",
            "262144": "256K",
            "294912": "288K",
            "327680": "320K",
            "360448": "352K",
            "393216": "384K",
            "425984": "416K",
            "458752": "448K",
            "491520": "480K",
            "524288": "512K",
            "557056": "544K",
            "589824": "576K",
            "622592": "608K",
            "655360": "640K"
          },
          "style": {
            "clear": "both",
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "cpu286",
      "class": "cpu",
      "model": 80286,
      "autoStart": true,
      "controls": [
        {
          "id": "reset",
          "type": "button",
          "label": "Reset",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        },
        {
          "id": "setSpeed",
          "type": "button",
          "label": "6Mhz",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "hdcAT",
      "class": "hdc",
      "type": "AT",
      "drives": [
        {
          "name": "BASICDOS-10MB",
          "type": 1,
          "path": "/software/disks/BASICDOS-10MB.json"
        }
      ],
      "controls": [
        {
          "id": "saveHD0",
          "type": "button",
          "label": "Save HD",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/keys.json",
    "/machines/pcx86/ibm/panel.json",
    {
      "id": "chipset",
      "class": "chipset",
      "model": 5170,
      "scaleTimers": false,
      "sound": true,
      "floppies": "[1200,1200]",
      "monitor": "color",
      "dateRTC": ""
    },
    {
      "id": "lpt1",
      "class": "parallel",
      "adapter": 2,
      "binding": "print"
    }
  ]
}
