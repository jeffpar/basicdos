        {
          "id": "saveDisk",
          "type": "button",
          "label": "Save",
          "style": {
            "padding-right": "8px"
          }
        },
        {
          "id": "descDisk",
          "type": "description",
          "style": {
            "padding-right": "8px"
          }
        },
        {
          "id": "mountDisk",
          "type": "file",
          "label": "Mount"
        }
      ]
