        {
          "id": "listDisks",
          "type": "list",
          "options": {
            "": "None",
            "/software/disks/PCDOS100.json": "PC DOS 1.00",
            "/software/disks/PCDOS110.json": "PC DOS 1.10",
            "/software/disks/PCDOS200-DISK1.json": "PC DOS 2.00 (Disk 1)",
            "/software/disks/PCDOS200-DISK2.json": "PC DOS 2.00 (Disk 2)"
          }
        },
        {
          "id": "loadDisk",
          "type": "button",
          "label": "Load"
