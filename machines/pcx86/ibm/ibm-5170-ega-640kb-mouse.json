            "16384": "16K",
            "32768": "32K",
            "49152": "48K",
            "65536": "64K",
            "98304": "96K",
            "131072": "128K",
            "163840": "160K",
            "196608": "192K",
            "229376": "224K",
            "262144": "256K",
            "294912": "288K",
            "327680": "320K",
            "360448": "352K",
            "393216": "384K",
            "425984": "416K",
            "458752": "448K",
            "491520": "480K",
            "524288": "512K",
            "557056": "544K",
            "589824": "576K",
            "622592": "608K",
            "655360": "640K"
