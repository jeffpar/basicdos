{
  "name": "IBM PC AT, 640Kb RAM, 10Mb Hard Disk, EGA, Serial Mouse",
  "defaults": {
    "ram": "640K",
    "fpu": "None",
    "fdc": "2 1.2Mb diskette drives",
    "parallel": "LPT1",
    "serial": "COM1, COM2 (serial mouse)",
    "hdc": "10Mb hard disk"
  },
  "machine": {
    "type": "pcx86",
    "name": "PCx86",
    "version": "2.26",
    "factory": "embedPCx86"
  },
  "components": [
    {
      "id": "pcEGA",
      "class": "computer",
      "busWidth": 24
    },
    {
      "id": "debugger",
      "class": "debugger",
      "debug": true
    },
    {
      "id": "romBIOS",
      "class": "rom",
      "addr": "0xf0000",
      "size": "0x10000",
      "file": "/machines/pcx86/roms/ATBIOS-REV3.json5",
      "alias": "0xff0000"
    },
    {
      "id": "romEGA",
      "class": "rom",
      "addr": "0xc0000",
      "size": "0x4000",
      "file": "/machines/pcx86/ibm/video/ega/1984-09-13/IBM-EGA.json5",
      "notify": "videoEGA"
    },
    {
      "id": "videoEGA",
      "class": "video",
      "title": "Enhanced Color Display",
      "model": "ega",
      "memory": "0x20000",
      "switches": "0110",
      "screenWidth": 1280,
      "screenHeight": 700,
      "screenColor": "black",
      "overlay": true,
      "controls": [
        {
          "type": "group",
          "style": {
            "float": "right"
          }
        },
        {
          "id": "caps-lock",
          "type": "led",
          "title": "Caps",
          "style": {
            "padding-left": "8px"
          }
        },
        {
          "id": "num-lock",
          "type": "led",
          "title": "Num",
          "style": {
            "padding-left": "8px"
          }
        },
        {
          "id": "scroll-lock",
          "type": "led",
          "title": "Scroll",
          "style": {
            "padding-left": "8px"
          }
        },
        {
          "id": "fullScreen",
          "type": "button",
          "label": "Full Screen",
          "style": {
            "padding-left": "8px",
            "line-height": "1em"
          }
        }
      ]
    },
    {
      "id": "com1",
      "class": "serial",
      "adapter": 1
    },
    {
      "id": "com2",
      "class": "serial",
      "adapter": 2
