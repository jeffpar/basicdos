          "style": {
            "clear": "both",
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "cpu286",
      "class": "cpu",
      "model": 80286,
      "autoStart": true,
      "controls": [
        {
          "id": "reset",
          "type": "button",
          "label": "Reset",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        },
        {
          "id": "setSpeed",
          "type": "button",
          "label": "6Mhz",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    {
      "id": "hdcAT",
      "class": "hdc",
      "type": "AT",
      "drives": [
        {
          "name": "BASICDOS-10MB",
          "type": 1,
          "path": "/software/disks/BASICDOS-10MB.json"
        }
      ],
      "controls": [
        {
          "id": "saveHD0",
          "type": "button",
          "label": "Save HD",
          "style": {
            "padding-right": "8px",
            "padding-bottom": "8px",
            "height": "22px"
          }
        }
      ]
    },
    "/machines/pcx86/ibm/keys.json",
    "/machines/pcx86/ibm/panel.json",
    {
      "id": "chipset",
      "class": "chipset",
      "model": 5170,
      "scaleTimers": false,
      "sound": true,
      "floppies": "[1200,1440]",
      "monitor": "ega",
      "dateRTC": ""
    },
    {
      "id": "lpt1",
      "class": "parallel",
      "adapter": 2,
      "binding": "print"
    },
    {
      "id": "mouse",
      "class": "mouse",
      "serial": "com2",
      "scaleMouse": 0.5
    }
  ]
