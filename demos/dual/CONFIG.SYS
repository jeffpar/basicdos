REM Demonstration of dual monitors with full-screen sessions
FILES=20
BUFFERS=4
SESSIONS=4
CONSOLE=CON:80,25
SHELL=COMMAND.COM PATH$="A:\;A:\EXT;A:\DEMOS;A:\SAMPLES":PRIMES.BAS
CONSOLE=CON:80,25,0,1
SHELL=COMMAND.COM PATH$="A:\;A:\EXT;A:\DEMOS":IF EXISTS("C:\SRC") THEN PATH$="C:\;C:\EXT;C:\TOOLS":C: :CD SRC :MK :ELSE PIPES.BAT
