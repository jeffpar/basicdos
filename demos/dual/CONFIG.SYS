REM Demonstration of dual monitors with full-screen sessions
FILES=20
BUFFERS=4
SESSIONS=4
CONSOLE=CON:80,25,0,0,0
SHELL=COMMAND.COM PATH$="A:\;A:\BIN;A:\SAMPLES;A:\DEMOS":PRIMES.BAT
CONSOLE=CON:80,25,0,0,0,1
SHELL=COMMAND.COM PATH$="A:\;A:\BIN;A:\DEMOS":IF EXISTS("C:\SRC") THEN PATH$="C:\;C:\BIN;C:\DEMOS;C:\SAMPLES;C:\TESTS;C:\TOOLS":C: :CD SRC :MK :ELSE PIPES.BAT
