REM Demonstration of two 40-column sessions, with DEBUG output enabled
REM BOOTKEY=B
FILES=8
BUFFERS=4
SESSIONS=4
REM DEBUG=COM1
DEBUG=COM1:9600,N,8,1,0
CONSOLE=CON:40,25,0,0,1
SHELL=COMMAND.COM LET PATH$="A:/;A:/BASIC;A:/TOOLS;A:/TESTS":COLOR 7,1:BD4.BAT
CONSOLE=CON:40,25,40,0,1
REM CONSOLE=COM1:9600,N,8,1
SHELL=COMMAND.COM LET PATH$="A:/;A:/BASIC;A:/TOOLS;A:/TESTS":BD3.BAT
