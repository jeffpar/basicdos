10 REM PAINT.BAS: scribble with the mouse in SCREEN 2 (640x200)
20 REM Hold the left button down to draw, and press ESC to exit
30 DEFINT A-Z:SCREEN 2:MOUSE ON:PX=-1:LX=-1
40 LOCATE 1,29:PRINT "Welcome BASIC-DOS Paint";
50 LINE (0,8)-(639,8):LINE (0,191)-(639,191)
60 X=MOUSE(3):Y=MOUSE(4):B=MOUSE(5)
70 IF X<>LX OR Y<>LY THEN LOCATE 25,1:PRINT MID$(STR$(X),2);",";MID$(STR$(Y),2);"   ";:LX=X:LY=Y
80 IF (B AND 1)=0 OR Y<9 OR Y>190 THEN PX=-1:GOTO 110
90 IF PX<0 THEN PSET (X,Y) ELSE LINE (PX,PY)-(X,Y)
100 PX=X:PY=Y
110 IF INKEY$<>CHR$(27) THEN 60
