REM Multiple Video Pages (0, 1, and 2) in protected mode, with DEBUG.COM on COM2
CPU=80286
DEVICE=EXT\DEBUG.COM COM2:9600,N,8,1,VT100
SHELL=C:COMMAND.COM PATH$="C:\;C:\EXT;C:\DEMOS;C:\SAMPLES;C:\TOOLS":HELLO.BAT
SHELL=C:COMMAND.COM PATH$="C:\;C:\EXT;C:\DEMOS;C:\SAMPLES;C:\TOOLS":FIBO.BAT
SHELL=C:COMMAND.COM PATH$="C:\;C:\EXT;C:\DEMOS;C:\SAMPLES;C:\TOOLS":PRIMES.BAS
