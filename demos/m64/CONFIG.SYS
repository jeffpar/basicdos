REM 64K demonstration: one session with no FPU$ (floating-point) or PIPE$
REM drivers; the drivers for hardware this machine lacks (serial and
REM parallel ports, mouse, and hard disk) unload themselves
SKIP=FPU$,PIPE$
BUFFERS=2
FILES=8
SESSIONS=1
SHELL=COMMAND.COM PATH$="A:\;A:\BIN;A:\DEMOS;A:\SAMPLES"
